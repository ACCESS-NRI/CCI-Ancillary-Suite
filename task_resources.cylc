[runtime]
	[[PBS_small_serial]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=1
			-l mem=10GB
			-l walltime=2:00:00
			-l jobfs=10GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ COMPUTE_PROJECT}}+scratch/{{ COMPUTE_PROJECT }}+scratch/{{ environ['PROJECT'] }}+gdata/{{ environ['PROJECT'] }}

  [[PBS_medium_serial]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=1
			-l mem=50GB
			-l walltime=2:00:00
			-l jobfs=50GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ COMPUTE_PROJECT}}+scratch/{{ COMPUTE_PROJECT }}+scratch/{{ environ['PROJECT'] }}+gdata/{{ environ['PROJECT'] }}   
	[[PBS_large_serial]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=1
			-l mem=100GB
			-l walltime=2:00:00
			-l jobfs=100GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ COMPUTE_PROJECT}}+scratch/{{ COMPUTE_PROJECT }}+scratch/{{ environ['PROJECT'] }}+gdata/{{ environ['PROJECT'] }}

	[[PBS_small_parallel]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=4
			-l mem=50GB
			-l walltime=2:00:00
			-l jobfs=50GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ COMPUTE_PROJECT}}+scratch/{{ COMPUTE_PROJECT }}+scratch/{{ environ['PROJECT'] }}+gdata/{{ environ['PROJECT'] }}
	[[PBS_medium_parallel]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=10
			-l mem=50GB
			-l walltime=4:00:00
			-l jobfs=50GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ COMPUTE_PROJECT}}+scratch/{{ COMPUTE_PROJECT }}+scratch/{{ environ['PROJECT'] }}+gdata/{{ environ['PROJECT'] }}
  
	[[PBS_long_parallel]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=10
			-l mem=50GB
			-l walltime=10:00:00
			-l jobfs=50GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ COMPUTE_PROJECT}}+scratch/{{ COMPUTE_PROJECT }}+scratch/{{ environ['PROJECT'] }}+gdata/{{ environ['PROJECT'] }}
  
	[[PBS_large_parallel]]
    platform = pbs
		[[[directives]]]
			-q = normal
      -P = {{ COMPUTE_PROJECT }}
			-l ncpus=48
			-l mem=190GB
			-l walltime=8:00:00
			-l jobfs=150GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ COMPUTE_PROJECT}}+scratch/{{ COMPUTE_PROJECT }}+scratch/{{ environ['PROJECT'] }}+gdata/{{ environ['PROJECT'] }}
  
	[[PBS_huge_parallel]]
		platform = pbs
		[[[directives]]]
			-q = hugemem
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=24
			-l mem=750GB
			-l walltime=2:00:00
			-l jobfs=100GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/cm45+gdata/{{ COMPUTE_PROJECT}}+scratch/{{ COMPUTE_PROJECT }}+scratch/{{ environ['PROJECT'] }}

	[[PBS_very_parallel]]
		platform = pbs
		[[[directives]]]
			-q = normalsr
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=104
			-l mem=500GB
			-l walltime=2:00:00
			-l jobfs=100GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/cm45+gdata/{{ COMPUTE_PROJECT}}+scratch/{{ COMPUTE_PROJECT }}+scratch/{{ environ['PROJECT'] }}
