[runtime]
	[[PBS_small_serial]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=1
			-l mem=10GB
			-l walltime=1:00:00
			-l jobfs=10GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ STORAGE_PROJECT }}+scratch/{{ STORAGE_PROJECT }}

  [[PBS_medium_serial]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=1
			-l mem=50GB
			-l walltime=1:00:00
			-l jobfs=50GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ STORAGE_PROJECT }}+scratch/{{ STORAGE_PROJECT }}
    
	[[PBS_large_serial]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=1
			-l mem=100GB
			-l walltime=10:00:00
			-l jobfs=100GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ STORAGE_PROJECT }}+scratch/{{ STORAGE_PROJECT }}

	[[PBS_small_parallel]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=4
			-l mem=50GB
			-l walltime=10:00:00
			-l jobfs=50GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ STORAGE_PROJECT }}+scratch/{{ STORAGE_PROJECT }}
	[[PBS_medium_parallel]]
    platform = pbs
		[[[directives]]]
			-q = normal
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=10
			-l mem=50GB
			-l walltime=10:00:00
			-l jobfs=50GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ STORAGE_PROJECT }}+scratch/{{ STORAGE_PROJECT }}
  
	[[PBS_large_parallel]]
    platform = pbs
		[[[directives]]]
			-q = normal
      -P = {{ COMPUTE_PROJECT }}
			-l ncpus=20
			-l mem=100GB
			-l walltime=10:00:00
			-l jobfs=100GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ STORAGE_PROJECT }}+scratch/{{ STORAGE_PROJECT }}
  
	[[PBS_huge_serial]]
		platform = pbs
		[[[directives]]]
			-q = hugemem
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=1
			-l mem=500GB
			-l walltime=4:00:00
			-l jobfs=100GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ STORAGE_PROJECT }}+scratch/{{ STORAGE_PROJECT }}

	[[PBS_huge_parallel]]
		platform = pbs
		[[[directives]]]
			-q = hugemem
			-P = {{ COMPUTE_PROJECT }}
			-l ncpus=20
			-l mem=1000GB
			-l walltime=4:00:00
			-l jobfs=100GB
			-l storage=gdata/hr22+gdata/xp65+gdata/vk83+gdata/access+gdata/{{ STORAGE_PROJECT }}+scratch/{{ STORAGE_PROJECT }}
