#!jinja2
{% include "task_resources.cylc" %}

[meta]
	title = "CCI Ancillary Suite"
	description = "Create a set of ancillaries using CCI Land Cover as the primary data source."

[scheduling]
	[[graph]]
		R1 = """
			ancil_lct => regrid_C4_fraction => ancil_C4_fraction
			ancil_lct => regrid_LAI
			(ancil_C4_fraction & regrid_LAI) => ancil_LAI
			ancil_LAI => ancil_canopy_height
			(ancil_LAI & ancil_canopy_height) => merge_veg_func
			ancil_C4_fraction => ancil_soil_hydrology
			ancil_C4_fraction => ancil_topographic_index
			ancil_lct => regrid_soil_albedo
			(ancil_C4_fraction & regrid_soil_albedo) => ancil_soil_albedo
			(ancil_soil_hydrology & ancil_soil_albedo) => merge_soils
			(ancil_C4_fraction & merge_soils) => ancil_soil_dust
			(ancil_lct & ancil_LAI) => ancil_soil_roughness
			(ancil_orographic_formdrag_preproc & ancil_lct) => ancil_orographic_formdrag
			(ancil_lct & ancil_orography_unfiltered_preproc) => ancil_orography_mean => ancil_orographic_wavedrag
			(ancil_aeroclim_preproc & ancil_orographic_wavedrag) => regrid_aerosol
			ancil_orographic_wavedrag => regrid_ozone
			ancil_lct => ancil_clim_dms
			ancil_lct => ancil_clim_sea
			(ancil_orography_unfiltered_preproc & ancil_lct) => ancil_radiation_parameters
			ancil_lct => regrid_seaice_reynolds
			ancil_lct => regrid_SST_reynolds
			(ancil_river_routing_preproc & ancil_lct) => ancil_river_routing
			ancil_river_routing => ancil_river_storage_preproc => ancil_river_storage
		"""
			
[runtime]
	[[root]]
		init-script = """
			module use /g/data/access/ngm/modules
			module load ants/2.1.0
			module load nco
		"""
		[[[environment]]]
			ANCIL_TARGET_PATH="/scratch/{{ STORAGE_PROJECT }}/${USER}/${CYLC_SUITE_NAME}"
			ANCIL_MASTER="/g/data/access/TIDS/UM/ancil"
			{% if LAND_MODEL == "CABLE" %}
				MODEL_ICE_TILE = 17
				MODEL_SOIL_TILE = 14
				MODEL_C3_GRASS_TILE = 6
				MODEL_C4_GRASS_TILE = 7
				MODEL_TREE_TILES = "1,2,3,4"
			{% elif LAND_MODEL == "JULES" %}
				MODEL_ICE_TILE = 9
				MODEL_SOIL_TILE = 8
				MODEL_C3_GRASS_TILE = 3
				MODEL_C4_GRASS_TILE = 4
				MODEL_TREE_TILES = "1,2"
			{% else %}
				{{ raise("Invalid LAND_MODEL: " ~ LAND_MODEL) }}
			{% endif %}	

	[[ancil_lct]]
        script = rose task-run
		inherit = PBS_huge_parallel
		[[[environment]]]
			{% if GRID_SOURCE == "grid_definition" %}
				GRID_ARG = "--target-grid={{ GRID_FILE }}"
			{% elif GRID_SOURCE == "land_sea_mask" %}
				GRID_ARG = "--target-lsm={{ GRID_FILE }}"
			{% endif %}

			{% if LAND_MODEL == "CABLE" %}
				DEFAULT_TRANSFORM = "cci2cable.json"
			{% elif LAND_MODEL == "JULES" %}
				DEFAULT_TRANSFORM = "cci2jules.json"
			{% endif %}

	[[regrid_C4_fraction]]
		script = rose task-run
		inherit = PBS_large_serial

	[[ancil_C4_fraction]]
		inherit = PBS_large_serial
		script = rose task-run

	[[regrid_LAI]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_LAI]]
		inherit = PBS_large_serial
		script = rose task-run
		[[[environment]]]
			{% if LAND_MODEL == "CABLE" %}
				DEFAULT_WEIGHTS = "lai_weights_cable.json"
			{% elif LAND_MODEL == "JULES" %}
				DEFAULT_WEIGHTS = "lai_weights_jules.json"
			{% endif %}

	[[ancil_canopy_height]]
		inherit = PBS_large_serial
		script = rose task-run
		[[[environment]]]
			{% if LAND_MODEL == "CABLE" %}
				DEFAULT_HEIGHT_FACTORS = "canopy_height_factors_cable.json"
			{% elif LAND_MODEL == "JULES" %}
				DEFAULT_HEIGHT_FACTORS = "canopy_height_factors_jules.json"
			{% endif %}

	[[merge_veg_func]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_soil_hydrology]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_topographic_index]]
		inherit = PBS_large_serial
		script = rose task-run

	[[regrid_soil_albedo]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_soil_albedo]]
		inherit = PBS_large_serial
		script = rose task-run

	[[merge_soils]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_soil_dust]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_soil_roughness]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_orographic_formdrag_preproc]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_orography_filtered_preproc]]
		inherit = PBS_huge_serial
		script = rose task-run

	[[ancil_orography_unfiltered_preproc]]
		inherit = PBS_medium_serial
		script = rose task-run

	[[ancil_orography_mean]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_orographic_formdrag]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_orographic_wavedrag]]
		inherit = PBS_small_serial
		script = rose task-run

	[[ancil_aeroclim_preproc]]
		inherit = PBS_large_serial
		script = rose task-run
		[[[environment]]]
			CALENDAR = {{ CALENDAR }}

	[[regrid_aerosol]]
		inherit = PBS_large_serial
		script = rose task-run

	[[regrid_ozone]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_radiation_parameters]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_clim_dms]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_clim_sea]]
		inherit = PBS_large_serial
		script = rose task-run

	[[regrid_seaice_reynolds]]
		inherit = PBS_large_serial
		script = rose task-run

	[[regrid_SST_reynolds]]
		inherit = PBS_large_serial
		script = rose task-run

	[[ancil_river_routing_preproc]]
		inherit = PBS_small_serial
		script = rose task-run

	[[ancil_river_routing]]
		inherit = PBS_small_serial
		script = rose task-run
	
	[[ancil_river_storage_preproc]]
		inherit = PBS_small_serial
		script = rose task-run

	[[ancil_river_storage]]
		inherit = PBS_small_serial
		script = rose task-run
