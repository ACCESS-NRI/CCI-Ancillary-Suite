#!jinja2
{% include "task_resources.cylc" %}

[meta]
	title = "CCI Ancillary Suite"
	description = "Create a set of ancillaries using CCI Land Cover as the primary data source."

[scheduling]
	[[graph]]
		R1 = """
            capture_provenance
			{% if GRID_SOURCE == "ocean_mesh" %}
				landseamask_from_ocean_mesh => ancil_lct
			{% endif %}
			preprocess_CCI_water => ancil_lct
			ancil_lct => regrid_ncar_lulcc
			ancil_lct => ancil_fix_antarctic_permanent_ice
			(ancil_fix_antarctic_permanent_ice & regrid_ncar_lulcc) => ancil_split_grass_types
			ancil_lct => regrid_LAI
			(ancil_split_grass_types & regrid_LAI) => ancil_LAI
			ancil_LAI => ancil_canopy_height
			(ancil_LAI & ancil_canopy_height) => merge_veg_func
			ancil_split_grass_types => ancil_soil_hydrology
			ancil_split_grass_types => ancil_topographic_index
			ancil_split_grass_types => ancil_soil_albedo
			(ancil_soil_hydrology & ancil_soil_albedo) => merge_soils
			(ancil_split_grass_types & merge_soils) => ancil_soil_dust
			(ancil_lct & ancil_LAI) => ancil_soil_roughness
            {% if ATMOSPHERE_ANCILLARIES %}
                (ancil_orographic_formdrag_preproc & ancil_lct) => ancil_orographic_formdrag
                (ancil_lct & ancil_orography_unfiltered_preproc) => ancil_orography_mean => ancil_orographic_wavedrag
                (ancil_aeroclim_preproc & ancil_orographic_wavedrag) => regrid_aerosol
                (ancil_orography_filtered_preproc & ancil_orography_mean) => ancil_orographic_wavedrag => regrid_ozone
                ancil_lct => ancil_clim_dms
                ancil_lct => ancil_clim_sea
                (ancil_orography_unfiltered_preproc & ancil_lct) => ancil_radiation_parameters
                ancil_lct => regrid_seaice_reynolds
                ancil_lct => regrid_SST_reynolds
                (ancil_river_routing_preproc & ancil_lct) => ancil_river_routing
                ancil_river_routing => ancil_river_storage_preproc => ancil_river_storage
        {% endif %}
		"""
			
[runtime]
	[[root]]
		init-script = """
			module use /g/data/xp65/public/modules
			module load conda/analysis3-25.08
			module load nco
		"""
        execution retry delays = 3*PT2M
		[[[environment]]]
			ANCIL_TARGET_PATH="/scratch/{{ STORAGE_PROJECT }}/${USER}/cylc-run/${CYLC_SUITE_NAME}/share/data"
			ANCIL_MASTER="/g/data/access/TIDS/UM/ancil"
			ANCIL_PREPROC_PATH="/g/data/access/TIDS/RMED/ANTS/preproc"
			CALENDAR={{ CALENDAR }}
			RESOLUTION={{ RESOLUTION }}
            VERTICAL_DISCRETIZATION={{ VERTICAL_DISCRETIZATION }}
			TARGET_LSM=${ANCIL_TARGET_PATH}/land_sea_mask/qrparm.mask
            TARGET_OCEAN=${ANCIL_TARGET_PATH}/land_sea_mask/qrparm.mask_sea
			TARGET_OROGRAPHIC_LSM=${ANCIL_TARGET_PATH}/orography/qrparm.orog_wavedrag
            CCI_YEAR={{ CCI_YEAR }}
			BEGIN_YEAR={{ BEGIN_YEAR }}
			END_YEAR={{ END_YEAR }}
			{% if LAND_MODEL == "CABLE" %}
				MODEL_ICE_TILE = 17
				MODEL_SOIL_TILE = 14
				MODEL_C3_GRASS_TILE = 6
				MODEL_C4_GRASS_TILE = 7
				MODEL_TREE_TILES = "1,2,3,4"
			{% elif LAND_MODEL == "JULES" %}
				MODEL_ICE_TILE = 9
				MODEL_SOIL_TILE = 8
				MODEL_C3_GRASS_TILE = 3
				MODEL_C4_GRASS_TILE = 4
				MODEL_TREE_TILES = "1,2"
			{% else %}
				{{ raise("Invalid LAND_MODEL: " ~ LAND_MODEL) }}
			{% endif %}	

	[[landseamask_from_ocean_mesh]]
		script = rose task-run
		inherit = PBS_small_serial
                [[[environment]]]
                        OCEAN_MESH = {{ GRID_FILE }}

        [[preprocess_CCI_water]]
                script = rose task-run
                inherit = PBS_huge_serial
 
	[[ancil_lct]]
		{% if GRID_SOURCE == "land_cover" %}
			script = rose task-run --command-key=grid_source
		{% elif GRID_SOURCE == "land_sea_mask" %}
			script = rose task-run --command-key=lsm_source
		{% elif GRID_SOURCE == "ocean_mesh" %}
			script = rose task-run --command-key=lsm_source
		{% endif %}
		inherit = PBS_medium_parallel
		init-script = """
			module use /g/data/access/ngm/modules
			module load ants/1.1.0
		"""
		[[[environment]]]
			{% if LAND_MODEL == "CABLE" %}
				DEFAULT_TRANSFORM = "cci2cable.json"
				{% if URBAN %}
					DEFAULT_TRANSFORM = "cci2cable_urban.json"
				{% endif %}
			{% elif LAND_MODEL == "JULES" %}
				DEFAULT_TRANSFORM = "cci2jules.json"
			{% endif %}

	[[regrid_C4_fraction]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_C4_fraction]]
		inherit = PBS_medium_parallel
		script = rose task-run

        [[ancil_fix_antarctic_permanent_ice]]
                inherit = PBS_medium_serial
                script = rose task-run

	[[regrid_ncar_lulcc]]
		inherit = PBS_medium_serial
		script = rose task-run

	[[ancil_split_grass_types]]
		inherit = PBS_medium_serial
		script = rose task-run
		[[[environment]]]
			{% if LAND_MODEL == "CABLE" %}
				DEFAULT_MAPPING = "ncar_grass_cable.json"
			{% elif LAND_MODEL == "JULES" %}
				DEFAULT_MAPPING = "ncar_grass_jules.json"
			{% endif %}

	[[regrid_LAI]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_LAI]]
		inherit = PBS_medium_parallel
		script = rose task-run
		[[[environment]]]
			{% if LAND_MODEL == "CABLE" %}
				DEFAULT_WEIGHTS = "lai_weights_cable.json"
			{% elif LAND_MODEL == "JULES" %}
				DEFAULT_WEIGHTS = "lai_weights_jules.json"
			{% endif %}

	[[ancil_canopy_height]]
		inherit = PBS_large_serial
		script = rose task-run
		[[[environment]]]
			{% if LAND_MODEL == "CABLE" %}
				DEFAULT_HEIGHT_FACTORS = "canopy_height_factors_cable.json"
			{% elif LAND_MODEL == "JULES" %}
				DEFAULT_HEIGHT_FACTORS = "canopy_height_factors_jules.json"
			{% endif %}

	[[merge_veg_func]]
		inherit = PBS_medium_serial
		script = rose task-run

	[[ancil_soil_hydrology]]
		inherit = PBS_long_parallel
		script = rose task-run
		init-script = """
			module use /g/data/access/ngm/modules
			module load ants/1.1.0
		"""

	[[ancil_topographic_index]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_soil_albedo]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[merge_soils]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_soil_dust]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_soil_roughness]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_orographic_formdrag_preproc]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_orography_filtered_preproc]]
		inherit = PBS_huge_parallel
		script = rose task-run

	[[ancil_orography_unfiltered_preproc]]
		inherit = PBS_huge_parallel
		script = rose task-run

	[[ancil_orography_mean]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_orographic_formdrag]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_orographic_wavedrag]]
		inherit = PBS_small_serial
		script = rose task-run

	[[ancil_aeroclim_preproc]]
		inherit = PBS_medium_parallel
		script = rose task-run
		init-script = """
			module use /g/data/access/ngm/modules
			module load ants/1.2.0
            module load nco
		"""
		[[[environment]]]
			CALENDAR = {{ CALENDAR }}

	[[regrid_aerosol]]
		inherit = PBS_large_parallel
		script = rose task-run

	[[regrid_ozone]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_radiation_parameters]]
		inherit = PBS_medium_parallel
		script = rose task-run

	[[ancil_clim_dms]]
		inherit = PBS_medium_serial
		script = rose task-run

	[[ancil_clim_sea]]
		inherit = PBS_medium_serial
		script = rose task-run

	[[regrid_seaice_reynolds]]
		inherit = PBS_large_parallel
		script = rose task-run

	[[regrid_SST_reynolds]]
		inherit = PBS_large_parallel
		script = rose task-run

	[[ancil_river_routing_preproc]]
		inherit = PBS_small_serial
		script = rose task-run

	[[ancil_river_routing]]
		inherit = PBS_small_serial
		script = rose task-run
	
	[[ancil_river_storage_preproc]]
		inherit = PBS_small_serial
		script = rose task-run

	[[ancil_river_storage]]
		inherit = PBS_small_serial
		script = rose task-run

    [[capture_provenance]]
        script = """
                mkdir ${ANCIL_TARGET_PATH}/provenance
                cp ${CYLC_WORKFLOW_LOG_DIR}/* ${ANCIL_TARGET_PATH/provenance
                """
