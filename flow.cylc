#!jinja2
{% import "task_resources.cylc" as resources %}

[meta]
	title = "CCI Ancillary Suite"
	description = "Create a set of ancillaries using CCI Land Cover as the data source."

[scheduling]
	[[graph]]
		R1 = """
			ancil_lct => regrid_C4_fraction => ancil_C4_fraction
			(regrid_LAI & ancil_C4_fraction) => ancil_LAI
			ancil_LAI => ancil_canopy_height
			(ancil_LAI & ancil_canopy_height) => merge_veg_func
			ancil_C4_fraction => ancil_soil_hydrology
			ancil_C4_fraction => ancil_topographic_index
			ancil_C4_fraction => ancil_soil_albedo
			(ancil_soil_hydrology & ancil_soil_albedo) => ancil_merge_soils
			(ancil_C4_fraction & ancil_merge_soils) => ancil_soil_dust
			(ancil_lct & ancil_LAI) => ancil_soil_roughness
			(ancil_orographic_formdrag_preproc & ancil_lct) => ancil_orographic_formdrag
			(ancil_orography_mean & ancil_orography_filtered_preproc & ancil_lct) => ancil_orographic_wavedrag
			(ancil_aeroclim_preproc & ancil_orographic_wavedrag) => regrid_aerosol
			ancil_orographic_wavedrag => regrid_ozone
			ancil_lct => ancil_clim_dms
			ancil_lct => ancil_clim_sea
			(ancil_orography_unfiltered_preproc & ancil_lct) => ancil_radiation_parameters
			ancil_lct => regrid_seaice_reynolds
			ancil_lct => regrid_SST_reynolds
			(ancil_river_routing_preproc & ancil_lct) => ancil_river_routing
			(ancil_river_storage_preproc & ancil_river_routing) => ancil_river_storage
		"""
			
[runtime]
	[[root]]
		platform = hpc
		script = """
			module use /g/data/access/modules
			module load ants/2.1.0
			%(script)s
		"""

	[[ancil_lct]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_lct"

	[[regrid_C4_fraction]]
		{{ resources.large_serial_task() }}
		script = echo "Running regrid_C4_fraction"

	[[ancil_C4_fraction]]
		{{ resources.small_serial_task() }}
		script = echo "Running ancil_C4_fraction"

	[[regrid_LAI]]
		{{ resources.large_serial_task() }}
		script = echo "Running regrid_LAI"

	[[ancil_LAI]]
		{{ resources.small_serial_task() }}
		script = echo "Running ancil_LAI"

	[[ancil_canopy_height]]
		{{ resources.small_serial_task() }}
		script = echo "Running ancil_canopy_height"

	[[merge_veg_func]]
		{{ resources.small_serial_task() }}
		script = echo "Running merge_veg_func"

	[[ancil_soil_hydrology]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_soil_hydrology"

	[[ancil_topographic_index]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_topographic_index"

	[[ancil_soil_albedo]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_soil_albeo"

	[[ancil_merge_soils]]
		{{ resources.small_serial_task() }}
		script = echo "Running ancil_merge_soils"

	[[ancil_soil_dust]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_soil_dust"

	[[ancil_soil_roughness]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_soil_roughness"

	[[ancil_orographic_formdrag_preproc]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_orographic_formdrag_preproc"

	[[ancil_orography_filtered_preproc]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_orography_filtered_preproc"

	[[ancil_orography_unfiltered_preproc]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_orography_unfiltered_preproc"

	[[ancil_orography_mean]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_orography_mean"

	[[ancil_orographic_formdrag]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_orographic_formdrag"

	[[ancil_orographic_wavedrag]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_orographic_wavedrag"

	[[ancil_aeroclim_preproc]]
		{{ resources.small_serial_task() }}
		script = echo "Running ancil_aeroclim_preproc"

	[[regrid_aerosol]]
		{{ resources.small_serial_task() }}
		script = echo "Running regrid_aerosol"

	[[regrid_ozone]]
		{{ resources.small_serial_task() }}
		script = echo "Running regrid_aerosol"

	[[ancil_radiation_parameters]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_radiation_parameters"

	[[ancil_clim_dms]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_clim_dms"

	[[ancil_clim_sea]]
		{{ resources.large_serial_task() }}
		script = echo "Running ancil_clim_sea"

	[[regrid_seaice_reynolds]]
		{{ resources.large_serial_task() }}
		script = echo "Running regrid_seaice_reynolds"

	[[regrid_SST_reynolds]]
		{{ resources.large_serial_task() }}
		script = echo "Running regrid_SST_reynolds"

	[[ancil_river_routing_preproc]]
		{{ resources.small_serial_task() }}
		script = echo "Running ancil_river_routing_preproc"

	[[ancil_river_routing]]
		{{ resources.small_serial_task() }}
		script = echo "Running ancil_river_routing"
	
	[[ancil_river_storage_preproc]]
		{{ resources.small_serial_task() }}
		script = echo "Running ancil_river_storage_preproc"

	[[ancil_river_storage]]
		{{ resources.small_serial_task() }}
		script = echo "Running ancil_river_storage"
